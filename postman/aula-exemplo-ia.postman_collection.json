{
  "info": {
    "_postman_id": "80d78712-8f83-4958-a5f1-d7f873ff191c",
    "name": "Aula Exemplo IA - API de tarefas",
    "description": "Coleção para testar somente as rotas existentes em /api/tasks e /api/health. Configure baseUrl para uma instância ligada a um banco isolado de testes antes de executar. A execução completa cria uma tarefa e tenta removê-la ao final; não use contra dados reais.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.text()) {",
          "  pm.test('Respostas com corpo usam JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "",
      "type": "string",
      "description": "URL da API em ambiente isolado, por exemplo http://localhost:3000"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string",
      "description": "Preenchido pela requisição de criação válida; usado nas operações de leitura, atualização e exclusão."
    },
    {
      "key": "missingTaskId",
      "value": "2147483647",
      "type": "string",
      "description": "ID positivo reservado para os exemplos de recurso inexistente. Confirme que não existe no banco isolado; PUT e DELETE verificam GET 404 antes de prosseguir."
    }
  ],
  "item": [
    {
      "name": "01 - Health e leitura da coleção",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('taskId');",
                  "pm.collectionVariables.unset('taskId');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 e status ok', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.have.property('status', 'ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "Listar tarefas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 e resposta em formato de lista', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            },
            "description": "Retorna todos os registros; execute somente contra o banco isolado configurado em baseUrl."
          }
        }
      ]
    },
