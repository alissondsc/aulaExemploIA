        {
          "name": "Rejeitar PUT para tarefa inexistente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl');",
                  "const missingId = pm.environment.get('missingTaskId') || pm.collectionVariables.get('missingTaskId');",
                  "if (!baseUrl || !missingId) {",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "  const url = baseUrl.replace(/\\/$/, '') + '/api/tasks/' + encodeURIComponent(missingId);",
                  "  pm.sendRequest({ url: url, method: 'GET', header: { Accept: 'application/json' } }, function (error, response) {",
                  "    if (error || response.code !== 404) pm.execution.skipRequest();",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404 sem atualizar registro', function () {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json()).to.have.property('message', 'Tarefa não encontrada.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Não deve ser persistido\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{missingTaskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{missingTaskId}}"
              ]
            },
            "description": "Só é enviada se uma consulta imediatamente anterior confirmar 404 para missingTaskId."
          }
        }
      ]
    },
    {
      "name": "05 - Exclusão",
      "item": [
        {
          "name": "DELETE - excluir somente a tarefa criada nesta execução",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const taskId = pm.environment.get('taskId') || pm.collectionVariables.get('taskId');",
                  "if (!taskId) pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204 sem corpo', function () {",
                  "  pm.response.to.have.status(204);",
                  "  pm.expect(pm.response.text()).to.eql('');",
                  "});",
                  "if (pm.response.code === 204) {",
                  "  pm.environment.unset('taskId');",
                  "  pm.collectionVariables.unset('taskId');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "Protegido para não enviar a requisição sem um taskId obtido da criação válida desta execução."
          }
        },
        {
          "name": "DELETE - confirmar 404 sem remover registro existente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl');",
                  "const missingId = pm.environment.get('missingTaskId') || pm.collectionVariables.get('missingTaskId');",
                  "if (!baseUrl || !missingId) {",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "  const url = baseUrl.replace(/\\/$/, '') + '/api/tasks/' + encodeURIComponent(missingId);",
                  "  pm.sendRequest({ url: url, method: 'GET', header: { Accept: 'application/json' } }, function (error, response) {",
                  "    if (error || response.code !== 404) pm.execution.skipRequest();",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404 para ID inexistente', function () {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json()).to.have.property('message', 'Tarefa não encontrada.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{missingTaskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{missingTaskId}}"
              ]
            },
            "description": "Só é enviada se um GET imediatamente anterior confirmar que missingTaskId retorna 404. Configure e execute apenas em banco isolado."
          }
        }
      ]
    }
  ]
}
