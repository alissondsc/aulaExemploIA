{
  "name": "aula-exemplo-backend-jp-2026",
  "version": "1.0.0",
  "description": "Crie um repositório novo no GitHub chamado APICalculadora utilizando a arquitetura REST\r Ela deve possuir as 4 operações básicas, assim como potência e raiz (Total: 6 operações);\r Realize também a separação adequada dos arquivos conforme vimos em aula.",
  "homepage": "https://github.com/renanponick/aula-exemplo-backend-jp-2026#readme",
  "bugs": {
    "url": "https://github.com/renanponick/aula-exemplo-backend-jp-2026/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renanponick/aula-exemplo-backend-jp-2026.git"
  },
  "license": "ISC",
  "author": "Renan",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "backend:install": "npm --prefix backend install",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend start",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "install:all": "npm run backend:install && npm run frontend:install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
